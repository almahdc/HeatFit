# PostHog project API key. This is the client-side "public" key — safe to
# ship in the built bundle, which is why it is committed rather than kept out
# of version control. It only lets PostHog accept events tagged with this
# project id; it grants no read access to data.
VITE_POSTHOG_KEY=phc_rzWXDDW5Qw6VcLf3povc4dqJAtmrJnfB4czeHE3rTfNt

# EU Cloud, to match this project's data residency.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Formspree endpoint for the early-access contact form (src/wizard/EarlyAccessBlock.tsx),
# pointed at heatfit.hello@gmail.com. Left blank, the form falls back to a
# mailto: link instead of failing silently.
VITE_FORM_ENDPOINT=https://formspree.io/f/meaqnzgy
