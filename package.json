{
  "name": "hp-engines",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsc --noEmit && vitest run",
    "verify:baseline": "vite-node scripts/verify-baseline.ts",
    "verify:alternatives": "vite-node scripts/verify-alternative-heating.ts",
    "verify:financing": "vite-node scripts/verify-grants-financing.ts",
    "watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "deploy": "npm run build:pages && touch dist/.nojekyll && gh-pages -d dist -t",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "deploy": "^1.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.42.0",
    "npm": "^11.19.0",
    "posthog-js": "^1.429.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "run": "^2.0.0"
  }
}
